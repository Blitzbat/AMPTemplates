App.AppSettings={}
App.EnvironmentVariables={"DOTNET_ENVIRONMENT":"standalone","HOME":"{{$FullRootDir}}home","LD_LIBRARY_PATH":"{{$FullRootDir}}linux64:{{$FullBaseDir}}:%LD_LIBRARY_PATH%"}
